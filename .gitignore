# Dependencias — se reinstalan con "npm install", no se versionan.
node_modules/

# Variables de entorno: llaves, contraseñas y secretos. NUNCA al repositorio.
# Los archivos .env.example sí van, porque solo documentan qué variables hacen falta.
.env
.env.*
!.env.example

# Python (el servicio de analítica): el entorno se arma con requirements.txt.
.venv/
__pycache__/
.pytest_cache/

# Compilados
dist/
build/

# Registros y cachés
*.log
npm-debug.log*
.vite/
.cache/

# Cosas del sistema y del editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

.claude

# Herramientas de asistencia (Impeccable): configuración local, no del proyecto.
.impeccable/

# Los videos (tráileres, presentación de Tiqui, tutoriales), la defensa, el
# banner de la Expo y las pruebas de voz se trabajan aparte y no van al
# repositorio. Ignorarlos aquí también los saca de lo que sube EAS al compilar
# la app: EAS sube todo lo que git no ignora, y eran casi 200 MB de video en
# cada compilación.
/trailer/
/trailer-tiqui/
/video-tiqui/
/videos-tutoriales/
/Defensa-Cartify.pdf
/banner-expo/
/pruebas-voz/

# Lo nativo de la app que se genera al compilar en esta computadora. Ya está
# en movil/.gitignore, pero EAS solo hace caso al de la raíz: sin esto subía
# casi 400 MB de compilaciones viejas que en la nube se vuelven a generar.
/movil/android/
/movil/ios/
